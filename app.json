{
  "expo": {
    "name": "TERA AGRO - SUARL",
    "slug": "gestion-p",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.gestionp.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto"
        ],
        "NSCameraUsageDescription": "Cette application utilise la caméra pour prendre des photos si nécessaire.",
        "NSPhotoLibraryUsageDescription": "Cette application accède à vos photos pour l'envoi ou la gestion d'images.",
        "NSLocationWhenInUseUsageDescription": "Cette application utilise votre position pour faciliter la livraison."
      }
    },
    "android": {
      "package": "sn.gestionp.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c29826a8-ffed-4f70-9188-4f8435ce0c45"
      }
    }
  }
}
